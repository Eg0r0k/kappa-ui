{
  "name": "@kappa-ui/core",
  "version": "0.2.0",
  "license": "MIT",
  "description": "The headless parts, directives and Tailwind utilities behind the kappa-ui registry.",
  "keywords": ["vue", "reka-ui", "tailwindcss", "shadcn-vue", "components", "headless"],
  "homepage": "https://kappa-ui.pages.dev",
  "bugs": "https://github.com/Eg0r0k/kappa-ui/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eg0r0k/kappa-ui.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./dialog": "./src/dialog/index.ts",
    "./menu": "./src/menu/index.ts",
    "./overlay": "./src/overlay/index.ts",
    "./ripple": "./src/ripple/index.ts",
    "./scroll-fade": "./src/scroll-fade/index.ts",
    "./tailwind.css": "./src/tailwind.css",
    "./toast": "./src/toast/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./dialog": { "types": "./dist/dialog/index.d.ts", "default": "./dist/dialog/index.js" },
      "./menu": { "types": "./dist/menu/index.d.ts", "default": "./dist/menu/index.js" },
      "./overlay": { "types": "./dist/overlay/index.d.ts", "default": "./dist/overlay/index.js" },
      "./ripple": { "types": "./dist/ripple/index.d.ts", "default": "./dist/ripple/index.js" },
      "./scroll-fade": { "types": "./dist/scroll-fade/index.d.ts", "default": "./dist/scroll-fade/index.js" },
      "./tailwind.css": "./dist/tailwind.css",
      "./toast": { "types": "./dist/toast/index.d.ts", "default": "./dist/toast/index.js" }
    }
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "tsdown",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "reka-ui": "2.10.5",
    "tsdown": "0.23.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  }
}
