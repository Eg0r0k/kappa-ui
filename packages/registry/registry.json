          "ease-bouncy": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
          "ease-elastic": "linear(0, 0.044, 0.155, 0.307, 0.476, 0.643, 0.795, 0.923, 1.023, 1.095, 1.139, 1.16, 1.162, 1.15, 1.129, 1.102, 1.075, 1.048, 1.025, 1.006, 0.991, 0.981, 0.976, 0.973, 0.974, 0.977, 0.981, 0.985, 0.99, 0.994, 0.997, 1)",
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
