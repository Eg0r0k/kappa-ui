{
  "$schema": "https://shadcn-vue.com/schema/registry.json",
  "name": "delta-ui",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "Utils",
      "description": "The cn() helper that merges Tailwind classes without conflicts.",
      "dependencies": ["clsx", "tailwind-merge"],
      "files": [
        {
          "path": "src/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "spinner",
      "type": "registry:ui",
      "title": "Spinner",
      "description": "Loading indicator driven by clip-path, inheriting colour from currentColor.",
      "registryDependencies": ["utils"],
      "files": [
        {
          "path": "src/ui/spinner/Spinner.vue",
          "type": "registry:ui"
        },
        {
          "path": "src/ui/spinner/index.ts",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Button with style and size variants, an optional expanded touch target, and as / as-child support.",
      "dependencies": ["class-variance-authority", "reka-ui"],
      "registryDependencies": ["utils"],
      "css": {
        "@layer base": {
          "button:not(:disabled), [role=\"button\"]:not(:disabled)": {
            "cursor": "pointer"
          }
        },
        "@utility press-scale": {
          "transition": "transform var(--press-duration) var(--ease-smooth, cubic-bezier(0.4, 0, 0.2, 1))",
          "transform": "scale(1)",
          "&:active": {
            "transform": "scale(var(--press-scale))"
          },
          ":where(.is-mobile) &": {
            "transform": "var(--transform-extra, none) scale3d(1, 1, 1)"
          },
          ":where(.is-mobile) &:active": {
            "transform": "var(--transform-extra, none) scale3d(var(--press-scale), var(--press-scale), 1)"
          },
          "@media (prefers-reduced-motion: reduce)": {
            "&": {
              "transition": "none",
              "transform": "none"
            },
            "&:active": {
              "transition": "none",
              "transform": "none"
            }
          }
        }
      },
      "cssVars": {
        "light": {
          "radius": "0.75rem",
          "press-scale": "0.97",
          "press-duration": "120ms",
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.145 0 0)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.52 0.2 262)",
          "primary-foreground": "oklch(0.985 0.01 262)",
          "secondary": "oklch(0.97 0 0)",
          "secondary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.556 0 0)",
          "accent": "oklch(0.97 0 0)",
          "accent-foreground": "oklch(0.205 0 0)",
          "destructive": "oklch(0.55 0.22 27)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "oklch(0.708 0 0)"
        },
        "dark": {
          "background": "oklch(0.145 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.205 0 0)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.205 0 0)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.66 0.17 262)",
          "primary-foreground": "oklch(0.21 0.04 262)",
          "secondary": "oklch(0.269 0 0)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.708 0 0)",
          "accent": "oklch(0.269 0 0)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.56 0.21 27)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.556 0 0)"
        },
        "theme": {
          "radius-sm": "calc(var(--radius) - 4px)",
          "radius-md": "calc(var(--radius) - 2px)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) + 4px)",
          "ease-smooth": "cubic-bezier(0.4, 0, 0.2, 1)",
          "ease-snappy": "cubic-bezier(0.16, 1, 0.3, 1)",
          "ease-gentle": "cubic-bezier(0.65, 0, 0.35, 1)",
          "ease-bouncy": "cubic-bezier(0.68, -0.55, 0.265, 1.55)",
          "ease-elastic": "linear(0, 0.044, 0.155, 0.307, 0.476, 0.643, 0.795, 0.923, 1.023, 1.095, 1.139, 1.16, 1.162, 1.15, 1.129, 1.102, 1.075, 1.048, 1.025, 1.006, 0.991, 0.981, 0.976, 0.973, 0.974, 0.977, 0.981, 0.985, 0.99, 0.994, 0.997, 1)",
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary": "var(--primary)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-destructive": "var(--destructive)",
          "color-border": "var(--border)",
          "color-input": "var(--input)",
          "color-ring": "var(--ring)"
        }
      },
      "files": [
        {
          "path": "src/ui/button/Button.vue",
          "type": "registry:ui"
        },
        {
          "path": "src/ui/button/index.ts",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
