{
  "name": "delta-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm registry:build && pnpm --filter @delta-ui/docs dev",
    "build": "pnpm registry:build && pnpm --filter @delta-ui/docs build",
    "preview": "pnpm --filter @delta-ui/docs preview",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "node --test scripts/build-registry.test.ts scripts/eslint-config.test.ts && pnpm -r test",
    "lint": "eslint packages/registry/src",
    "registry:build": "node scripts/build-registry.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "typescript": "~6.0.2",
    "vue-eslint-parser": "^10.4.1"
  }
}
