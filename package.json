{
  "name": "delta-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm registry:build && pnpm --filter @delta-ui/docs dev",
    "build": "pnpm registry:build && pnpm --filter @delta-ui/docs build",
    "preview": "pnpm --filter @delta-ui/docs preview",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm format:check && node --test scripts/build-registry.test.ts scripts/eslint-config.test.ts scripts/css-sync.test.ts && pnpm lint && pnpm -r test",
    "lint": "eslint packages/core/src packages/registry/src apps/docs/app scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "registry:build": "node scripts/build-registry.ts"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-vue": "^10.11.1",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1"
  }
}
