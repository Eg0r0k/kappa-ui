{
  "name": "kappa-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm registry:build && pnpm --filter @kappa-ui/docs dev",
    "build": "pnpm registry:build && pnpm --filter @kappa-ui/docs build",
    "preview": "pnpm --filter @kappa-ui/docs preview",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm format:check && node --test scripts/build-registry.test.ts scripts/registry-css.test.ts scripts/eslint-config.test.ts scripts/release.test.ts scripts/figma/color.test.ts scripts/figma/tokens.test.ts && pnpm lint && pnpm -r test",
    "test:visual": "pnpm --filter @kappa-ui/registry test:visual",
    "lint": "eslint packages/core/src packages/registry/src apps/docs/app scripts",
    "format": "pnpm format:classes && prettier --write . && pnpm format:classes",
    "format:classes": "eslint --fix --fix-type layout packages/registry/src apps/docs/app",
    "format:check": "prettier --check .",
    "registry:build": "node scripts/build-registry.ts",
    "smoke": "node scripts/smoke.ts",
    "changeset": "changeset",
    "release": "node scripts/release.ts"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/node": "^24.13.3",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-vue": "^10.11.1",
    "postcss": "^8.5.28",
    "prettier": "3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "wrangler": "4.142.0"
  }
}
